{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "talcs",
  "description": "TALCS: Audio Library of CrSjimo",
  "version": "0.0.1.1",
  "homepage": "https://talcs.sjimo.dev/",
  "license": "LGPL-2.1",
  "dependencies": [
    "libsndfile",
    "rpclib",
    "rtmidi",
    {
      "name": "asiosdk",
      "platform": "windows"
    },
    {
      "name": "pipewire",
      "platform": "linux"
    },
    {
      "name": "pulseaudio",
      "platform": "linux"
    },
    {
      "name": "jack2",
      "platform": "linux"
    },
    {
      "name": "alsa",
      "platform": "linux"
    },
    "interval-tree",
    "boost-interprocess",
    "qmsetup",
    "wavpack",
    "r8brain-free-src"
  ],
  "builtin-baseline": "dd6fbdd22cc56af2ec8f97b4f62ce5ef612a891b",
  "vcpkg-configuration": {
    "overlay-ports": [
      "../vcpkg/ports"
    ],
    "overlay-triplets": [
      "../vcpkg/triplets"
    ]
  }
